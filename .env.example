PROJECT_NAME="Medical RAG Bot"
ENVIRONMENT="development"

# API Keys (Google AI Studio)
GEMINI_API_KEY=AQ.your-gemini-api-key
# Zalo OA (Optional until Zalo module is implemented)
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DB="medical_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="medrag"
REDIS_SOCKET_TIMEOUT=2.0
REDIS_MEMORY_MAX_TURNS=5
REDIS_MEMORY_MAX_CHARS=500
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_CACHE_TTL_SECONDS=3600

# Zalo OA
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_SECRET_KEY=""
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_API_BASE_URL="https://openapi.zalo.me"
ZALO_OAUTH_BASE_URL="https://oauth.zaloapp.com"
ZALO_REQUEST_TIMEOUT=5.0
ZALO_REPLY_MAX_CHARS=2000
ZALO_EVENT_DEDUP_TTL_SECONDS=3600
ZALO_TOKEN_REFRESH_LEEWAY_SECONDS=300
ZALO_WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300
